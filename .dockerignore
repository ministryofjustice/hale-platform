# Directories
/wordpress
/squarepants

# Local clones of the MoJ repositories (bin/clone-repos.sh). Bind-mounted into
# the containers at /mnt/dev by docker-compose.yml, never COPYed by any
# dockerfile - so shipping them to the daemon as build context is ~1GB of
# node_modules and git history read over Docker Desktop's file sharing on every
# build, for nothing.
/dev

# Database files
*.sql

# Other
.git
**/.git
.DS_Store
.env
.env.local
auth.json

# WordPress related
# We can't ignore these as we need them when building the image
!/wordpress/wp-content/plugins
!/wordpress/wp-content/themes
!/wordpress/wp-content/mu-plugins

# Test-only files inside the Lua module tree - keep out of the nginx image
opt/lua/firewall/firewall_e2e_test.mjs
opt/lua/firewall/fixtures
