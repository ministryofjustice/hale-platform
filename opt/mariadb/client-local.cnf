# MariaDB client settings for LOCAL DEVELOPMENT ONLY.
#
# Mounted into the wp-tools container by docker-compose.yml. Not baked into the
# image and not present in any deployed environment.
#
# Recent MariaDB clients attempt TLS by default, and the local `mariadb` service
# is a plain container with no certificates configured, so `wp db check`,
# `wp db optimize` and `wp db repair` (which shell out to mariadb-check) fail
# with:
#   Got error: 2026: TLS/SSL error: SSL is required, but the server does not
#   support it when trying to connect
#
# Disabling TLS is correct here and would NOT be correct in a deployed
# environment: there the database is RDS, which supports TLS, and the client
# should keep negotiating it. That is why this lives in a compose-only mount
# rather than in wptools.dockerfile.
[client]
ssl = 0
